#include <stdio.h>
#include <stdlib.h>

int SIZE = 5;   //
int TOTAL_BARCOS =4;    //

//  FUNCION PARA INICIALIZAR EL TABLERO

void inicializarTablero(char tablero[SIZE][SIZE]){
    for(int i=0; i<SIZE; i++){
        for(int j=0; j<SIZE; j++){
            tablero[i][j]= '~';
        }
    }
}

void mostrarTablero(char tablero[SIZE][SIZE]){
    printf(" ");
    for(int j=0; j<SIZE; j++){
        printf("%d ", j);
    }
    printf("\n");
    for(int i=0; i<SIZE; i++){
        printf("%d", i);
        for(int j=0; j<SIZE; j++){
            printf("%c ", tablero[i][j]);
        }
        printf("\n");
    }
    }
    
