            tableroP1[r][c] = 'B';
        } else {
            printf("Coordenada invalida o ya ocupada. Intenta de nuevo... \n");
            i--;
        }
    }
    
    printf("=== JUGADOR 2: Colocar tus %d barcos ===\n", TOTAL_BARCOS);
    for(int i=0; i<TOTAL_BARCOS; i++){
        int r, c;
        printf("Posicion del barco %d (fila columna): ", i + 1);
        scanf("%d %d", &r, &c);
        if(r>=0 && r<SIZE && c>=0 && c<SIZE && tableroP2[r][c] == '~'){
